#!/usr/bin/env python3
"""A stand-in for `codex exec`. Reviews pass, unless $FAKE_SCRIPT has {"reject_rounds": N}: then the first N
review rounds of every PR return one major finding."""

import json
import os
import re
import sys

argv = sys.argv[1:]
out = argv[argv.index("-o") + 1]
schema = json.load(open(argv[argv.index("--output-schema") + 1]))
prompt = sys.stdin.read()
script = json.load(open(os.environ["FAKE_SCRIPT"])) if os.path.exists(os.environ.get("FAKE_SCRIPT", "")) else {}
log = os.environ.get("FAKE_AGENT_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"cli": "codex", "argv": argv, "cwd": os.getcwd(), "prompt": prompt}) + "\n")

if "findings" not in schema["properties"]:
    sys.exit("fake codex only reviews")
earlier = len(re.findall(r"^### (Round|第) ", prompt, re.M))
findings = []
if earlier < script.get("reject_rounds", 0):
    findings = [{"severity": "major", "file": "x.py", "line": 1, "problem": "missing test", "suggestion": "add one"}]
obj = {"summary": f"review after {earlier} earlier round(s)", "findings": findings, "out_of_scope": []}
with open(out, "w") as f:
    json.dump(obj, f)
