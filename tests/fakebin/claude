#!/usr/bin/env python3
"""A stand-in for `claude -p` that answers by schema, so tests run without a model.

Builders write a file and commit it. $FAKE_SCRIPT (a JSON file) can change the behavior:
  {"fail_build": true}           every build call fails
  {"plan": [...]}                the issues the planner returns
  {"proposals": [...]}           proposed_issues returned by the first build call
  {"triage": [...]}              triage decisions
"""

import json
import os
import re
import subprocess
import sys

argv = sys.argv[1:]
schema = json.loads(argv[argv.index("--json-schema") + 1])
props = schema["properties"]
prompt = sys.stdin.read()
script = json.load(open(os.environ["FAKE_SCRIPT"])) if os.path.exists(os.environ.get("FAKE_SCRIPT", "")) else {}
log = os.environ.get("FAKE_AGENT_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"cli": "claude", "argv": argv[:1] + [a for a in argv if a.startswith("--")],
                            "cwd": os.getcwd(), "prompt": prompt}) + "\n")


def done(obj):
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "structured_output": obj}))
    sys.exit(0)


if "issues" in props:
    done({"issues": script.get("plan", [
        {"key": "a", "title": "Add feature A", "body": "Background\n\nDo A.", "depends_on": []},
        {"key": "b", "title": "Add feature B", "body": "Background\n\nDo B.", "depends_on": ["a"]},
    ])})
if "decisions" in props:
    done({"decisions": script.get("triage", [])})
if "decision" in props:
    done({"decision": script.get("arbitrate", "merge"), "reason": "fake arbitration", "new_body": ""})
if "proposed_issues" in props:
    if script.get("fail_build"):
        print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "boom"}))
        sys.exit(1)
    n = re.search(r"#(\d+)", prompt).group(1)
    attempt = len([f for f in os.listdir(".") if f.startswith(f"feature-{n}")])
    with open(f"feature-{n}-{attempt}.txt", "w") as f:
        f.write("done\n")
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", f"feat: feature {n} ({attempt})"], check=True)
    proposals = script.get("proposals", []) if attempt == 0 else []
    done({"summary": f"built #{n} attempt {attempt}", "proposed_issues": proposals})
sys.exit(f"fake claude: unknown schema {list(props)}")
